{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "gameslideshow",
  "post": {
    "dir": "dist/client",
    "entrypoints": {
      "default": {
        "inline": true,
        "entry": "splash.html"
      },
      "game": {
        "entry": "game.html"
      }
    }
  },
  "server": {
    "dir": "dist/server",
    "entry": "index.cjs"
  },
  "menu": {
    "items": [
      {
        "label": "Create Launchpad Post",
        "description": "Create the Word Game Arcade launchpad post",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/post-create"
      },
      {
        "label": "Seed Games (round 1)",
        "description": "Load the initial set of games into Redis",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/seed"
      },
      {
        "label": "Reset Games (clear all)",
        "description": "Delete all game records and indexes",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/reset"
      },
      {
        "label": "Add Game",
        "description": "Add a game to the launchpad",
        "location": ["subreddit", "post"],
        "forUserType": "moderator",
        "endpoint": "/internal/menu/add-game"
      },
      {
        "label": "Edit Game",
        "description": "Edit an existing game",
        "location": "post",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/edit-game"
      },
      {
        "label": "Submit Your Game",
        "description": "Submit a word game for review",
        "location": "post",
        "forUserType": "user",
        "endpoint": "/internal/menu/submit-game"
      }
    ]
  },
  "forms": {
    "addGame": "/internal/form/add-submit",
    "editGame": "/internal/form/edit-submit",
    "submitGame": "/internal/form/submit-submit"
  },
  "triggers": {
    "onAppInstall": "/internal/triggers/on-app-install"
  },
  "scheduler": {
    "tasks": {
      "refresh-subscribers": {
        "endpoint": "/internal/scheduler/refresh-subscribers",
        "cron": "0 0 * * 0"
      },
      "notify-aged-out": {
        "endpoint": "/internal/scheduler/notify-aged-out",
        "cron": "0 9 * * 1"
      }
    }
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build"
  },
  "dev": {
    "subreddit": "gameslideshow_dev"
  }
}